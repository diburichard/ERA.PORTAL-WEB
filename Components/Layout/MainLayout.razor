@inherits LayoutComponentBase
@inject MudTheme Theme

@* <MudThemeProvider Theme="@Theme"> *@
<MudThemeProvider Theme="@Theme" />
    <MudLayout>
        <MudDrawer Open="true" ClipMode="DrawerClipMode.Always">
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudAppBar Color="Color.Primary">
                <MudText Typo="Typo.h6">Mi Aplicación</MudText>
                <MudSpacer />
               @*  <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="CambiarTema">
                    Cambiar Tema
                </MudButton> *@
            </MudAppBar>
            <MudContainer MaxWidth="MaxWidth.Large">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
@* </MudThemeProvider> *@
