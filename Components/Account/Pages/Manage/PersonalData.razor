@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor
@using MudBlazor

<PageTitle>Personal Data</PageTitle>

<StatusMessage />

<MudPaper Class="pa-6 mx-auto" MaxWidth="600px" Elevation="2">
    <MudText Typo="Typo.h5" GutterBottom="true">Personal Data</MudText>
    <MudText Typo="Typo.body1" Class="mb-2">
        Your account contains personal data that you have given us. This page allows you to download or delete that data.
    </MudText>
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-4">
        <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
    </MudAlert>
    <MudStack Direction="Row" Spacing="2">
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary">
                Download
            </MudButton>
        </form>
        <MudButton Href="Account/Manage/DeletePersonalData" Variant="Variant.Filled" Color="Color.Error">
            Delete
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
